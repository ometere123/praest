pragma solidity ^0.8.28;
import {Script,console2} from "forge-std/Script.sol";import {StudioDecisionGateway} from "../src/StudioDecisionGateway.sol";import {PraestEscrow} from "../src/PraestEscrow.sol";import {PraestSettlementReceiver} from "../src/PraestSettlementReceiver.sol";import {IMailbox} from "../src/interfaces/IHyperlane.sol";
contract DeployGateway is Script{function run()external{address mailbox=vm.envAddress("HYPERLANE_MAILBOX");uint256 pk=vm.envUint("EVM_DEPLOYER_PRIVATE_KEY_UINT");address admin=vm.addr(pk);vm.startBroadcast(pk);StudioDecisionGateway g=new StudioDecisionGateway(admin,mailbox);vm.stopBroadcast();console2.log("gateway",address(g));}}
contract DeployDestination is Script{function run()external{address mailbox=vm.envAddress("HYPERLANE_MAILBOX");uint32 local=uint32(vm.envUint("HYPERLANE_LOCAL_DOMAIN"));uint32 origin=uint32(vm.envUint("PRAEST_ORIGIN_DOMAIN"));bytes32 sender=vm.envBytes32("PRAEST_ORIGIN_SENDER");uint256 pk=vm.envUint("EVM_DEPLOYER_PRIVATE_KEY_UINT");address admin=vm.addr(pk);address ism=address(IMailbox(mailbox).defaultIsm());require(ism!=address(0),"default ISM unavailable");vm.startBroadcast(pk);PraestEscrow e=new PraestEscrow(admin);PraestSettlementReceiver r=new PraestSettlementReceiver(admin,mailbox,local,origin,sender,ism,e);e.setSettler(address(r),true);vm.stopBroadcast();console2.log("escrow",address(e));console2.log("receiver",address(r));console2.log("ism",ism);}}
