{
  "name": "praest",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "doctor": "node scripts/doctor.mjs",
    "verify:repo": "node scripts/verify-repo.mjs",
    "genlayer:deploy": "tsx scripts/deploy-focused-genlayer.ts",
    "verify:release": "node scripts/verify-repo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "genlayer-js": "2.0.0-rc.1"
  }
}
