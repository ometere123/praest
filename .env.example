# PRAEST — copy to .env.local. Never commit real secrets.

# Core
NODE_ENV=development
PRAEST_ENV=development
PRAEST_RELEASE=local
PRAEST_APP_URL=http://localhost:3000
PRAEST_API_URL=http://localhost:4000
NEXT_PUBLIC_PRAEST_API_URL=http://localhost:4000
PRAEST_INTERNAL_TOKEN=replace-with-64-random-chars
PRAEST_DATA_ENCRYPTION_KEY_BASE64=replace-with-base64-of-32-random-bytes
PRAEST_RATE_LIMIT_PER_MINUTE=120
PORT=4000

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@localhost:5432/praest

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_JWKS_URL=

# Privy (WorkOS JWT/custom-auth provider configured in Privy dashboard)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Temporal - used identically by apps/api and apps/worker (packages/config's
# temporalConnectionOptions()). Local default below targets `temporal server
# start-dev` on your machine. For a self-hosted Railway deployment, set
# TEMPORAL_ADDRESS to that service's Railway private-network address, e.g.
# temporal.railway.internal:7233 (see docs/DEPLOYMENT.md); leave
# TEMPORAL_API_KEY blank and TEMPORAL_TLS=false - no TLS/API key is required
# for self-hosted. To use Temporal Cloud instead, set TEMPORAL_ADDRESS to
# your Cloud namespace's gRPC endpoint and TEMPORAL_API_KEY to a Cloud API
# key; TLS is then enabled automatically (no other change needed).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS=false
TEMPORAL_TASK_QUEUE=praest

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=praest
CLICKHOUSE_MEASUREMENTS_TABLE=measurements

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=praest-evidence
R2_REGION=auto

# Regional probes (apps/probe) - PROBE_PROVIDER selects the transport.
# Default is Globalping (globalping.io), which needs no AWS/card-based infra.
PROBE_PROVIDER=globalping
# Comma-separated Globalping location strings (country name/ISO code, city,
# "US-NY" state, "ASxxxx" ASN, or continent - fuzzy-matched by Globalping).
# Also stores each monitor's chosen probe regions (praest.monitors.regions);
# use the same values there. Defaults to a 5-continent spread if unset.
GLOBALPING_PROBE_LOCATIONS=US,Germany,Singapore,Brazil,Japan
GLOBALPING_MEASUREMENT_TYPE=http
# Optional - anonymous Globalping use works, just with a lower hourly credit
# allowance tied to your IP instead of your account. Get one at
# https://dash.globalping.io if you need more headroom.
GLOBALPING_API_TOKEN=

# AWS is no longer used anywhere in this repo (the AWS Lambda + EventBridge
# regional-probe deployment was retired in favor of Globalping - see
# docs/DEPLOYMENT.md #8). AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION
# have no remaining consumer and are intentionally not listed here.

# GenLayer StudioNet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_STUDIONET_PRIVATE_KEY=
# Legacy compatibility only; prefer GENLAYER_STUDIONET_PRIVATE_KEY
GENLAYER_PRIVATE_KEY=
GENLAYER_AGREEMENT_REGISTRY_ADDRESS=
GENLAYER_EVIDENCE_ASSESSOR_ADDRESS=
GENLAYER_SERVICE_ASSURANCE_RESOLVER_ADDRESS=
GENLAYER_DISPUTE_RESOLVER_ADDRESS=
GENLAYER_SETTLEMENT_ENTITLEMENT_ADDRESS=
GENLAYER_AGENT_AGREEMENT_RESOLVER_ADDRESS=
GENLAYER_LIABILITY_RESOLVER_ADDRESS=
GENLAYER_EVENT_RESOLVER_ADDRESS=
GENLAYER_DECISION_OUTBOX_ADDRESS=
PRAEST_SETTLEMENT_INSTRUCTION_TTL_SECONDS=86400

# Hyperlane Studio bridge origin (zkSync Sepolia)
PRAEST_HYPERLANE_ORIGIN_DOMAIN=300
EVM_DEPLOYER_PRIVATE_KEY=
BRIDGE_EVM_PRIVATE_KEY=
HYPERLANE_RELAYER_PRIVATE_KEY=
ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
PRAEST_STUDIO_GATEWAY_ADDRESS=
# Runtime bridge canonical name
ZKSYNC_STUDIO_DECISION_GATEWAY_ADDRESS=
BRIDGE_POLL_MS=10000

# Destination EVM RPCs
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
OPTIMISM_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
SCROLL_SEPOLIA_RPC_URL=
LINEA_SEPOLIA_RPC_URL=

# Solana Testnet
SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
SOLANA_KEYPAIR_PATH=
PRAEST_SOLANA_PROGRAM_ID=
PRAEST_SOLANA_TEST_MINT=

# Stripe - use Sandbox/Test mode values only (dashboard toggle top-right).
# STRIPE_SECRET_KEY starts with sk_test_ (never sk_live_).
STRIPE_SECRET_KEY=
# From the CLI (`stripe listen --forward-to ...`, prints whsec_...) for local
# dev, or a Test mode webhook endpoint's signing secret for a deployed one.
# Never a Live mode endpoint's secret.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) of two Test mode recurring Prices you create.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Must match a Test mode Billing Meter's event_name exactly, or
# billing.meterEvents.create (BillingService.usage) will fail.
STRIPE_METER_EVENT_NAME=praest_usage

# Resend
RESEND_API_KEY=
RESEND_FROM=PRAEST <notifications@example.com>

# Sentry / OpenTelemetry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# x402 V2
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=
X402_PAY_TO_EVM=
X402_PAY_TO_SOLANA=

# TLSNotary / Internet Court
TLSNOTARY_VERIFIER_URL=
TLSNOTARY_WEBHOOK_TOKEN=
INTERNET_COURT_API_URL=
INTERNET_COURT_API_KEY=
