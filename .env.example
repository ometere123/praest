# PRAEST — copy to .env.local. Never commit real secrets.

# Core
NODE_ENV=development
PRAEST_ENV=development
PRAEST_RELEASE=local
PRAEST_APP_URL=http://localhost:3000
PRAEST_API_URL=http://localhost:4000
NEXT_PUBLIC_PRAEST_API_URL=http://localhost:4000
PRAEST_INTERNAL_TOKEN=replace-with-64-random-chars
PRAEST_DATA_ENCRYPTION_KEY_BASE64=replace-with-base64-of-32-random-bytes
PRAEST_RATE_LIMIT_PER_MINUTE=120
PORT=4000

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@localhost:5432/praest

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_JWKS_URL=

# Privy (WorkOS JWT/custom-auth provider configured in Privy dashboard)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS=false
TEMPORAL_TASK_QUEUE=praest

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=praest
CLICKHOUSE_MEASUREMENTS_TABLE=measurements

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=praest-evidence
R2_REGION=auto

# AWS regional probes
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRAEST_PROBE_SHARED_SECRET=

# GenLayer StudioNet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_STUDIONET_PRIVATE_KEY=
# Legacy compatibility only; prefer GENLAYER_STUDIONET_PRIVATE_KEY
GENLAYER_PRIVATE_KEY=
GENLAYER_AGREEMENT_REGISTRY_ADDRESS=
GENLAYER_EVIDENCE_ASSESSOR_ADDRESS=
GENLAYER_SERVICE_ASSURANCE_RESOLVER_ADDRESS=
GENLAYER_DISPUTE_RESOLVER_ADDRESS=
GENLAYER_SETTLEMENT_ENTITLEMENT_ADDRESS=
GENLAYER_AGENT_AGREEMENT_RESOLVER_ADDRESS=
GENLAYER_LIABILITY_RESOLVER_ADDRESS=
GENLAYER_EVENT_RESOLVER_ADDRESS=
GENLAYER_DECISION_OUTBOX_ADDRESS=
PRAEST_SETTLEMENT_INSTRUCTION_TTL_SECONDS=86400

# Hyperlane Studio bridge origin (zkSync Sepolia)
PRAEST_HYPERLANE_ORIGIN_DOMAIN=300
EVM_DEPLOYER_PRIVATE_KEY=
BRIDGE_EVM_PRIVATE_KEY=
HYPERLANE_RELAYER_PRIVATE_KEY=
ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
PRAEST_STUDIO_GATEWAY_ADDRESS=
# Runtime bridge canonical name
ZKSYNC_STUDIO_DECISION_GATEWAY_ADDRESS=
BRIDGE_POLL_MS=10000

# Destination EVM RPCs
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
OPTIMISM_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
SCROLL_SEPOLIA_RPC_URL=
LINEA_SEPOLIA_RPC_URL=

# Solana Testnet
SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
SOLANA_KEYPAIR_PATH=
PRAEST_SOLANA_PROGRAM_ID=
PRAEST_SOLANA_TEST_MINT=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_METER_EVENT_NAME=praest_usage

# Resend
RESEND_API_KEY=
RESEND_FROM=PRAEST <notifications@example.com>

# Sentry / OpenTelemetry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=

# x402 V2
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=
X402_PAY_TO_EVM=
X402_PAY_TO_SOLANA=

# TLSNotary / Internet Court
TLSNOTARY_VERIFIER_URL=
TLSNOTARY_WEBHOOK_TOKEN=
INTERNET_COURT_API_URL=
INTERNET_COURT_API_KEY=
